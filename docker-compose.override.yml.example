# Docker Compose Override Example
# Copy this file to docker-compose.override.yml and customize for your environment

version: "3.8"
services:
  application:
    environment:
      CONSOLE_HOST: http://localhost:4200
      # If you override the database connection for Docker, keep the host as `database`
      # unless you are pointing at an external MySQL server.
      # DATABASE_URL: mysql://<user>:<password>@database/fleetbase
      # Add your environment-specific variables here
      MAIL_MAILER: smtp  # or ses, mailgun, postmark, sendgrid
      OSRM_HOST: https://router.project-osrm.org
      # FLEETBASE_HOST: https://api.fleetbase.io
      # IPINFO_API_KEY: your_api_key
      # GOOGLE_MAPS_API_KEY: your_api_key
      # GOOGLE_MAPS_LOCALE: us
      # TWILIO_SID: your_twilio_sid
      # TWILIO_TOKEN: your_twilio_token
      # TWILIO_FROM: your_twilio_phone
      # FLEETBASE_API_KEY: rotate_and_set_a_fresh_api_key
      # GOOGLE_DRIVE_FOLDER_ID: your_google_drive_folder_id
    volumes:
      - ./api/app/Console/Commands/ImportXlsxViaApiCommand.php:/fleetbase/api/app/Console/Commands/ImportXlsxViaApiCommand.php
      - ./api/app/Helpers/GoogleDriveDownloader.php:/fleetbase/api/app/Helpers/GoogleDriveDownloader.php
      - ./api/app/Helpers/FleetbaseImporter.php:/fleetbase/api/app/Helpers/FleetbaseImporter.php
      - ./api/config/import.php:/fleetbase/api/config/import.php

  socket:
    environment:
      # DEVELOPMENT: Allow localhost connections (HTTP, HTTPS, and WebSocket protocols)
      SOCKETCLUSTER_OPTIONS: '{"origins":"http://localhost:*,https://localhost:*,ws://localhost:*,wss://localhost:*"}'
      
      # PRODUCTION: Replace with your actual domain(s) - include all protocols
      # SOCKETCLUSTER_OPTIONS: '{"origins":"https://yourdomain.com:*,wss://yourdomain.com:*,https://app.yourdomain.com:*,wss://app.yourdomain.com:*"}'